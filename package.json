{
  "name": "tilbe-kurban",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:local": "next dev",
    "dev:https": "next dev --experimental-https --hostname 0.0.0.0",
    "build": "next build --webpack",
    "postbuild": "node scripts/sw-version-gen.mjs",
    "sw:version": "node scripts/sw-version-gen.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "check:utf8": "node scripts/check-utf8.mjs",
    "validate:docs": "node scripts/validate-docs.mjs --check-inventory",
    "validate:docs:write": "node scripts/validate-docs.mjs --write-inventory",
    "test:docs": "vitest run tests/validate-docs.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:platform-postgres": "vitest run packages/database-platform/tests/platform-postgres.integration.test.ts",
    "test:tenant-isolation": "vitest run packages/database-tenant/tests/tenant-isolation.integration.test.ts",
    "provisioning:cli": "tsx apps/provisioning-cli/src/cli.ts",
    "provisioning:worker": "tsx apps/provisioning-cli/src/cli.ts worker --once",
    "tenant:ops": "tsx apps/tenant-ops-cli/src/cli.ts",
    "tenant:ops:worker": "tsx apps/tenant-ops-cli/src/cli.ts worker --once",
    "platform-admin:dev": "pnpm --filter @tilbecore/platform-admin dev",
    "platform-admin:build": "pnpm --filter @tilbecore/platform-admin build",
    "platform-admin:bootstrap": "pnpm --filter @tilbecore/platform-admin bootstrap",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-pwa": "5.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-swipeable": "^7.0.2",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tilbecore/config": "workspace:*",
    "@tilbecore/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.9.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
