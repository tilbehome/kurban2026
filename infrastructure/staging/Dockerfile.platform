FROM node:22.13.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN chmod 0555 /workspace/infrastructure/staging/scripts/*.sh
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate --schema packages/database-platform/prisma/schema.prisma
RUN pnpm --filter @tilbecore/platform-admin build

FROM node:22.13.0-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build --chown=nextjs:nodejs /workspace/apps/platform-admin/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /workspace/apps/platform-admin/.next/static ./apps/platform-admin/.next/static
COPY --from=build --chown=nextjs:nodejs /workspace/infrastructure/staging/scripts/with-secrets.sh /usr/local/bin/with-secrets
RUN chmod 0555 /usr/local/bin/with-secrets
USER nextjs
EXPOSE 3100
ENTRYPOINT ["/usr/local/bin/with-secrets"]
CMD ["node", "apps/platform-admin/server.js"]
