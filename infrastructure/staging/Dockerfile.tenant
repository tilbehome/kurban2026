FROM node:22.13.0-bookworm-slim AS tools
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN chmod 0555 /workspace/infrastructure/staging/scripts/*.sh
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate --schema prisma/schema.prisma \
 && pnpm exec prisma generate --schema packages/database-platform/prisma/schema.prisma \
 && pnpm exec prisma generate --schema packages/database-tenant/prisma/schema.prisma

FROM tools AS build
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=file:/tmp/tilbecore-build.db
ENV SESSION_SECRET=build_only_session_secret_32_characters
ENV DEKONT_DOGRULAMA_SECRET=build_only_dekont_secret_32_characters
RUN pnpm build

FROM node:22.13.0-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build --chown=nextjs:nodejs /workspace/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /workspace/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /workspace/public ./public
COPY --from=build --chown=nextjs:nodejs /workspace/infrastructure/staging/scripts/with-secrets.sh /usr/local/bin/with-secrets
RUN chmod 0555 /usr/local/bin/with-secrets
USER nextjs
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/with-secrets"]
CMD ["node", "server.js"]
