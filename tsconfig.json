{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@tilbecore/config": ["./packages/config/src/index.ts"],
      "@tilbecore/contracts": ["./packages/contracts/src/index.ts"],
      "@tilbecore/offline": ["./packages/offline/src/index.ts"],
      "@tilbecore/observability": ["./packages/observability/src/index.ts"],
      "@tilbecore/observability/node": ["./packages/observability/src/node.ts"],
      "@tilbecore/operations": ["./packages/operations/src/index.ts"],
      "@tilbecore/platform": ["./packages/platform/src/index.ts"],
      "@tilbecore/provisioning": ["./packages/provisioning/src/index.ts"],
      "@tilbecore/tenant-core": ["./packages/tenant-core/src/index.ts"],
      "@tilbecore/tenant-runtime": ["./packages/tenant-runtime/src/index.ts"],
      "@tilbecore/tenant-web-runtime": ["./packages/tenant-web-runtime/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "apps/platform-admin", "apps/platform-admin/.next"]
}
