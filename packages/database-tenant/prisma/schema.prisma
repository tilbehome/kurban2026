  componentType   String
  weightKg        Decimal       @db.Decimal(12, 3)
  estimatedValue  Decimal?      @db.Decimal(18, 4)
  createdAt       DateTime      @default(now())
  packageRecord   PackageRecord @relation(fields: [packageRecordId], references: [id])

  @@index([packageRecordId])
  @@index([componentType])
}

model ColdStorageRoom {
  id         String               @id
  facilityId String?
  code       String
  name       String
  active     Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  sections   ColdStorageSection[]
  racks      ColdStorageRack[]
  packages   PackageRecord[]
  locations  PackageLocation[]

  @@unique([facilityId, code])
  @@index([facilityId, active])
}

model ColdStorageSection {
  id        String            @id
  roomId    String
  code      String
  name      String
  active    Boolean           @default(true)
  room      ColdStorageRoom   @relation(fields: [roomId], references: [id])
  racks     ColdStorageRack[]
  packages  PackageRecord[]
  locations PackageLocation[]

  @@unique([roomId, code])
}

model ColdStorageRack {
  id        String              @id
  roomId    String
  sectionId String?
  code      String
  name      String?
  active    Boolean             @default(true)
  room      ColdStorageRoom     @relation(fields: [roomId], references: [id])
  section   ColdStorageSection? @relation(fields: [sectionId], references: [id])
  packages  PackageRecord[]
  locations PackageLocation[]

  @@unique([roomId, sectionId, code])
}

model PackageLocation {
  id              String              @id
  packageRecordId String
  roomId          String
  sectionId       String?
  rackId          String?
  status          String              @default("active")
  placedAt        DateTime
  removedAt       DateTime?
  reason          String?
  packageRecord   PackageRecord       @relation(fields: [packageRecordId], references: [id])
  room            ColdStorageRoom     @relation(fields: [roomId], references: [id])
  section         ColdStorageSection? @relation(fields: [sectionId], references: [id])
  rack            ColdStorageRack?    @relation(fields: [rackId], references: [id])

  @@index([packageRecordId, status])
  @@index([roomId, sectionId, rackId, status])
}

model DeliveryProof {
  id               String         @id
  deliveryRecordId String
  proofType        String
  storageKey       String?
  note             String?
  capturedAt       DateTime
  deliveryRecord   DeliveryRecord @relation(fields: [deliveryRecordId], references: [id])

  @@index([deliveryRecordId])
}

model DeliveryVehicle {
  id           String        @id
  plateNo      String        @unique
  displayName  String
  active       Boolean       @default(true)
  tasks        VehicleTask[]
  loadingLists LoadingList[]
}

model VehicleTask {
  id          String          @id
  vehicleId   String
  seasonId    String
  status      String          @default("planned")
  assignedTo  String?
  startsAt    DateTime?
  completedAt DateTime?
  vehicle     DeliveryVehicle @relation(fields: [vehicleId], references: [id])

  @@index([seasonId, status])
}

model LoadingList {
  id         String            @id
  seasonId   String
  vehicleId  String?
  status     String            @default("draft")
  routeName  String?
  createdAt  DateTime          @default(now())
  vehicle    DeliveryVehicle?  @relation(fields: [vehicleId], references: [id])
  items      LoadingListItem[]
  deliveries DeliveryRecord[]

  @@index([seasonId, status])
}

model LoadingListItem {
  loadingListId   String
  packageRecordId String
  status          String        @default("planned")
  loadedAt        DateTime?
  loadingList     LoadingList   @relation(fields: [loadingListId], references: [id])
  packageRecord   PackageRecord @relation(fields: [packageRecordId], references: [id])

  @@id([loadingListId, packageRecordId])
}

model SavedDashboardView {
  id                       String   @id
  organizationMembershipId String?
  name                     String
  scope                    String
  filters                  Json
  layout                   Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([organizationMembershipId, scope])
}

model OfflineQueueItem {
  id             String   @id
  idempotencyKey String   @unique
  operation      String
  payload        Json
  status         String
  createdAt      DateTime @default(now())

  @@index([status])
}

model DeviceAdapter {
  id           String   @id
  kind         String
  displayName  String
  capabilities Json
  enabled      Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
}
