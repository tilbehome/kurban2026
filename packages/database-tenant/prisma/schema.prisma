generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model TenantProvisioningMarker {
  id               String   @id
  provisioningJobId String
  tenantInstanceId String
  databaseRefId    String
  createdAt        DateTime @default(now())
}

model Season {
  id         String   @id
  locationId String?
  name       String
  year       Int?
  status     String
  startsAt   DateTime?
  endsAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  location   Location? @relation(fields: [locationId], references: [id])
  legacyCustomers Customer[] @relation("LegacyCustomerSeason")
  customerAccounts CustomerSeasonAccount[]
  animals   Animal[]
  shareCards ShareCard[]
  sales     Sale[]
  ledgerEntries LedgerEntry[]
  slaughterJobs SlaughterJob[]
  supplierAccounts SupplierAccount[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  expenseDocuments ExpenseDocument[]
  qurbanAssignments QurbanAssignment[]

  @@index([locationId])
  @@index([status])
}

model OrganizationUser {
  id             String   @id
  email          String?  @unique
  displayName    String
  status         String   @default("active")
  legacyUserId   String?  @unique
  externalRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    OrganizationMembership[]
  trustedDevices TrustedDevice[]
}

model OrganizationMembership {
  id                 String   @id
  organizationUserId String
  status             String   @default("active")
  validFrom          DateTime @default(now())
  validUntil         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organizationUser   OrganizationUser @relation(fields: [organizationUserId], references: [id])
  roleAssignments    MembershipRole[] @relation("MembershipRoleTarget")
  assignedRoles      MembershipRole[] @relation("MembershipRoleAssigner")
  createdRoleVersions RoleVersion[] @relation("RoleVersionCreator")
  delegationsFrom    Delegation[] @relation("DelegationSource")
  delegationsTo      Delegation[] @relation("DelegationTarget")
  approvedDelegations Delegation[] @relation("DelegationApprover")
  userSessions       UserSession[]
  createdServiceAccounts ServiceAccount[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions  ApprovalDecision[] @relation("ApprovalDecider")

  @@index([organizationUserId, status])
  @@index([validUntil])
}

model ModuleAuthorizationRegistration {
  id          String   @id
  moduleId    String
  version     String
  displayName String
  active      Boolean  @default(true)
  registeredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions Permission[]
  roles       Role[]

  @@unique([moduleId, version])
  @@index([moduleId, active])
}

model Role {
  id                   String   @id
  name                 String
  description          String?
  type                 String
  protectedCode        String?  @unique
  functionalArea       String
  accessLevel          String
  moduleRegistrationId String?
  sourceRoleId         String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  moduleRegistration   ModuleAuthorizationRegistration? @relation(fields: [moduleRegistrationId], references: [id])
  sourceRole           Role? @relation("RoleTemplateCopy", fields: [sourceRoleId], references: [id])
  copiedRoles          Role[] @relation("RoleTemplateCopy")
  versions             RoleVersion[]

  @@index([type, active])
  @@index([functionalArea, accessLevel])
  @@index([moduleRegistrationId])
}

model RoleVersion {
  id                    String   @id
  roleId                String
  version               Int
  status                String   @default("draft")
  changeReason          String
  createdByMembershipId String
  createdAt             DateTime @default(now())
  publishedAt           DateTime?
  retiredAt             DateTime?
  role                  Role @relation(fields: [roleId], references: [id])
  createdBy             OrganizationMembership @relation("RoleVersionCreator", fields: [createdByMembershipId], references: [id])
  permissions           RolePermission[]
  membershipRoles       MembershipRole[]
  conditionalPolicies   ConditionalPolicy[]

  @@unique([roleId, version])
  @@index([roleId, status])
}

model Permission {
  id                   String   @id
  key                  String   @unique
  moduleId             String
  resource             String
  action               String
  scope                String
  description          String?
  riskLevel            String   @default("normal")
  moduleRegistrationId String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  moduleRegistration   ModuleAuthorizationRegistration? @relation(fields: [moduleRegistrationId], references: [id])
  rolePermissions      RolePermission[]
  conditionalPolicies  ConditionalPolicy[]
  delegations          Delegation[]
  approvalPolicies     ApprovalPolicy[] @relation("ApprovalTargetPermission")
  approverPolicies     ApprovalPolicy[] @relation("ApprovalApproverPermission")
  serviceAccountGrants ServiceAccountPermission[]
  deviceGrants         DevicePermission[]
  externalUserGrants   ExternalUserPermission[]

  @@unique([moduleId, resource, action, scope])
  @@index([moduleId, active])
}

model RolePermission {
  roleVersionId String
  permissionId  String
  effect        String
  constraints   Json?
  createdAt     DateTime @default(now())
  roleVersion   RoleVersion @relation(fields: [roleVersionId], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id])

  @@id([roleVersionId, permissionId])
  @@index([permissionId, effect])
}

model AccessScope {
  id                    String   @id
  name                  String
  facilityId            String?
  departmentId          String?
  operationalPeriodId   String?
  assignedRecordType    String?
  assignedRecordId      String?
  additionalConstraints Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  membershipRoles       MembershipRole[]
  delegations           Delegation[]
  serviceAccountGrants  ServiceAccountPermission[]
  deviceGrants          DevicePermission[]
  externalUserGrants    ExternalUserPermission[]
}

model MembershipRole {
  id                     String   @id
  membershipId           String
  roleVersionId          String
  accessScopeId          String?
  validFrom              DateTime @default(now())
  validUntil             DateTime?
  assignedByMembershipId String
  assignmentReason       String
  revokedAt              DateTime?
  revokedByMembershipId  String?
  createdAt              DateTime @default(now())
  membership             OrganizationMembership @relation("MembershipRoleTarget", fields: [membershipId], references: [id])
  roleVersion            RoleVersion @relation(fields: [roleVersionId], references: [id])
  accessScope            AccessScope? @relation(fields: [accessScopeId], references: [id])
  assignedBy             OrganizationMembership @relation("MembershipRoleAssigner", fields: [assignedByMembershipId], references: [id])
  conditionalPolicies    ConditionalPolicy[]

  @@index([membershipId, revokedAt, validUntil])
  @@index([roleVersionId])
}

model ConditionalPolicy {
  id               String   @id
  name             String
  roleVersionId    String?
  membershipRoleId String?
  permissionId     String?
  effect           String
  priority         Int      @default(0)
  conditions       Json
  active           Boolean  @default(true)
  validFrom        DateTime?
  validUntil       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  roleVersion      RoleVersion? @relation(fields: [roleVersionId], references: [id])
  membershipRole   MembershipRole? @relation(fields: [membershipRoleId], references: [id])
  permission       Permission? @relation(fields: [permissionId], references: [id])

  @@index([permissionId, active])
  @@index([roleVersionId, active])
}

model Delegation {
  id                       String   @id
  fromMembershipId         String
  toMembershipId           String
  permissionId             String
  accessScopeId            String?
  reason                   String
  validFrom                DateTime
  validUntil               DateTime
  status                   String   @default("active")
  approvedByMembershipId   String?
  revokedAt                DateTime?
  createdAt                DateTime @default(now())
  fromMembership           OrganizationMembership @relation("DelegationSource", fields: [fromMembershipId], references: [id])
  toMembership             OrganizationMembership @relation("DelegationTarget", fields: [toMembershipId], references: [id])
  approvedBy               OrganizationMembership? @relation("DelegationApprover", fields: [approvedByMembershipId], references: [id])
  permission               Permission @relation(fields: [permissionId], references: [id])
  accessScope              AccessScope? @relation(fields: [accessScopeId], references: [id])

  @@index([toMembershipId, status, validUntil])
  @@index([fromMembershipId, status])
}

model ApprovalPolicy {
  id                    String   @id
  name                  String
  permissionId          String
  approverPermissionId  String
  conditions            Json
  requiredApprovals     Int      @default(1)
  requireDistinctUser   Boolean  @default(true)
  requireReauthentication Boolean @default(true)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  permission            Permission @relation("ApprovalTargetPermission", fields: [permissionId], references: [id])
  approverPermission    Permission @relation("ApprovalApproverPermission", fields: [approverPermissionId], references: [id])
  requests              ApprovalRequest[]

  @@index([permissionId, active])
}

model ApprovalRequest {
  id                    String   @id
  approvalPolicyId      String
  requestedByMembershipId String
  operationType         String
  operationRef          String
  payloadHash           String
  reason                String
  status                String   @default("pending")
  expiresAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  approvalPolicy        ApprovalPolicy @relation(fields: [approvalPolicyId], references: [id])
  requestedBy           OrganizationMembership @relation("ApprovalRequester", fields: [requestedByMembershipId], references: [id])
  decisions             ApprovalDecision[]

  @@unique([operationType, operationRef, payloadHash])
  @@index([status, expiresAt])
}

model ApprovalDecision {
  id                   String   @id
  approvalRequestId    String
  decidedByMembershipId String
  decision             String
  reason               String
  reauthenticatedAt    DateTime
  decidedAt            DateTime
  approvalRequest      ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  decidedBy            OrganizationMembership @relation("ApprovalDecider", fields: [decidedByMembershipId], references: [id])

  @@unique([approvalRequestId, decidedByMembershipId])
}

model UserSession {
  id                       String   @id
  organizationMembershipId String
  tokenHash                String   @unique
  status                   String   @default("active")
  mfaLevel                 Int      @default(1)
  authenticatedAt          DateTime
  lastReauthenticatedAt    DateTime?
  trustedDeviceId          String?
  networkFingerprint       String?
  expiresAt                DateTime
  revokedAt                DateTime?
  createdAt                DateTime @default(now())
  membership               OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])
  trustedDevice            TrustedDevice? @relation(fields: [trustedDeviceId], references: [id])

  @@index([organizationMembershipId, status])
  @@index([expiresAt])
}

model TrustedDevice {
  id                 String   @id
  organizationUserId String
  displayName        String
  fingerprintHash    String
  trustStatus        String   @default("trusted")
  trustedAt          DateTime
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organizationUser   OrganizationUser @relation(fields: [organizationUserId], references: [id])
  sessions           UserSession[]

  @@unique([organizationUserId, fingerprintHash])
  @@index([trustStatus, expiresAt])
}

model ServiceAccount {
  id                    String   @id
  name                  String
  clientId              String   @unique
  credentialHash        String
  status                String   @default("active")
  createdByMembershipId String
  validUntil            DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             OrganizationMembership @relation(fields: [createdByMembershipId], references: [id])
  permissions           ServiceAccountPermission[]
}

model ServiceAccountPermission {
  serviceAccountId String
  permissionId     String
  accessScopeId    String?
  effect           String
  validFrom        DateTime @default(now())
  validUntil       DateTime?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id])
  permission       Permission @relation(fields: [permissionId], references: [id])
  accessScope      AccessScope? @relation(fields: [accessScopeId], references: [id])

  @@id([serviceAccountId, permissionId])
}

model DeviceIdentity {
  id              String   @id
  kind            String
  displayName     String
  credentialHash  String   @unique
  status          String   @default("active")
  facilityId      String?
  validUntil      DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  permissions     DevicePermission[]
}

model DevicePermission {
  deviceIdentityId String
  permissionId     String
  accessScopeId    String?
  effect           String
  validFrom        DateTime @default(now())
  validUntil       DateTime?
  deviceIdentity   DeviceIdentity @relation(fields: [deviceIdentityId], references: [id])
  permission       Permission @relation(fields: [permissionId], references: [id])
  accessScope      AccessScope? @relation(fields: [accessScopeId], references: [id])

  @@id([deviceIdentityId, permissionId])
}

model ExternalUser {
  id          String   @id
  issuer      String
  subject     String
  email       String?
  displayName String?
  status      String   @default("active")
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions ExternalUserPermission[]

  @@unique([issuer, subject])
}

model ExternalUserPermission {
  externalUserId String
  permissionId   String
  accessScopeId  String?
  effect         String
  validFrom      DateTime @default(now())
  validUntil     DateTime?
  externalUser   ExternalUser @relation(fields: [externalUserId], references: [id])
  permission     Permission @relation(fields: [permissionId], references: [id])
  accessScope    AccessScope? @relation(fields: [accessScopeId], references: [id])

  @@id([externalUserId, permissionId])
}

model AuthorizationAudit {
  id                       String   @id
  identityKind             String
  subjectId                String?
  organizationMembershipId String?
  sessionId                String?
  permissionKey            String
  resourceType             String?
  resourceId               String?
  decision                 String
  reasonCodes              Json
  evaluatedPolicies        Json?
  contextSnapshot          Json?
  requestId                String
  traceId                  String?
  occurredAt               DateTime

  @@index([organizationMembershipId, occurredAt])
  @@index([permissionKey, decision, occurredAt])
  @@index([requestId])
}

model BusinessProfile {
  id              String   @id
  legalName       String
  displayName     String
  taxOffice       String?
  taxNumber       String?
  phone           String?
  email           String?
  defaultCurrency String   @default("TRY")
  locale          String   @default("tr-TR")
  timeZone        String   @default("Europe/Istanbul")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Location {
  id          String   @id
  code        String   @unique
  name        String
  addressLine String?
  district    String?
  city        String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seasons     Season[]
}

model Setting {
  id          String   @id
  scope       String
  key         String
  value       Json
  version     Int      @default(1)
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
}

model Customer {
  id                     String   @id
  seasonId               String?
  displayName            String
  normalizedName         String   @default("")
  phone                  String?
  normalizedPhone        String?
  identityNumber         String?
  notes                  String?
  active                 Boolean  @default(true)
  kvkkConsentAt          DateTime?
  communicationConsentAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  legacySeason           Season?  @relation("LegacyCustomerSeason", fields: [seasonId], references: [id])
  phones                 CustomerPhone[]
  addresses              CustomerAddress[]
  seasonAccounts         CustomerSeasonAccount[]
  sales                  Sale[]
  shares                 Share[]
  ledgerEntries          LedgerEntry[]
  proxyDocuments         ProxyDocument[]
  deliveries             DeliveryRecord[]

  @@index([seasonId])
  @@index([normalizedPhone])
  @@index([normalizedName])
  @@index([active])
}

model CustomerPhone {
  id              String   @id
  customerId      String
  label           String?
  phone           String
  normalizedPhone String
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([normalizedPhone])
}

model CustomerAddress {
  id          String   @id
  customerId  String
  label       String?
  addressLine String
  district    String?
  city        String?
  postalCode  String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerSeasonAccount {
  id          String   @id
  customerId  String
  seasonId    String
  status      String   @default("open")
  debitTotal  Decimal  @default(0) @db.Decimal(18, 4)
  creditTotal Decimal  @default(0) @db.Decimal(18, 4)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  season      Season   @relation(fields: [seasonId], references: [id])

  @@unique([customerId, seasonId])
  @@index([seasonId])
}

model Supplier {
  id          String   @id
  displayName String
  phone       String?
  taxNumber   String?
  normalizedName String @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  animals     Animal[]
  accounts    SupplierAccount[]
  purchaseInvoices PurchaseInvoice[]
  payments    SupplierPayment[]

  @@index([normalizedName])
}

model SupplierAccount {
  id          String   @id
  supplierId  String
  seasonId    String
  debitTotal  Decimal  @default(0) @db.Decimal(18, 4)
  creditTotal Decimal  @default(0) @db.Decimal(18, 4)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  season      Season   @relation(fields: [seasonId], references: [id])

  @@unique([supplierId, seasonId])
  @@index([seasonId])
}

model PurchaseInvoice {
  id             String   @id
  supplierId     String
  seasonId       String
  invoiceNo      String
  invoiceDate    DateTime
  status         String   @default("posted")
  currency       String   @default("TRY")
  subtotal       Decimal  @db.Decimal(18, 4)
  taxTotal       Decimal  @default(0) @db.Decimal(18, 4)
  grandTotal     Decimal  @db.Decimal(18, 4)
  idempotencyKey String   @unique
  reversalOfId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  season         Season   @relation(fields: [seasonId], references: [id])
  lines          PurchaseInvoiceLine[]
  reversalOf     PurchaseInvoice? @relation("PurchaseInvoiceReversal", fields: [reversalOfId], references: [id])
  reversals      PurchaseInvoice[] @relation("PurchaseInvoiceReversal")

  @@unique([supplierId, invoiceNo])
  @@index([seasonId])
}

model PurchaseInvoiceLine {
  id               String   @id
  purchaseInvoiceId String
  lineNo           Int
  description      String
  animalId         String?  @unique
  quantity         Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice        Decimal  @db.Decimal(18, 4)
  lineTotal        Decimal  @db.Decimal(18, 4)
  expenseDocumentId String?
  createdAt        DateTime @default(now())
  purchaseInvoice  PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  animal           Animal? @relation(fields: [animalId], references: [id])
  expenseDocument  ExpenseDocument? @relation(fields: [expenseDocumentId], references: [id])

  @@unique([purchaseInvoiceId, lineNo])
}

model SupplierPayment {
  id             String   @id
  supplierId     String
  seasonId       String
  amount         Decimal  @db.Decimal(18, 4)
  method         String
  referenceNo    String?
  occurredAt     DateTime
  idempotencyKey String   @unique
  reversalOfId   String?
  createdAt      DateTime @default(now())
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  season         Season   @relation(fields: [seasonId], references: [id])
  reversalOf     SupplierPayment? @relation("SupplierPaymentReversal", fields: [reversalOfId], references: [id])
  reversals      SupplierPayment[] @relation("SupplierPaymentReversal")

  @@index([supplierId, seasonId])
}

model ExpenseDocument {
  id             String   @id
  seasonId       String
  documentNo     String?
  category       String
  description    String
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @default("TRY")
  sourceType     String
  sourceRef      String
  occurredAt     DateTime
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  season         Season   @relation(fields: [seasonId], references: [id])
  purchaseLines  PurchaseInvoiceLine[]

  @@unique([sourceType, sourceRef])
  @@index([seasonId])
}

model Animal {
  id              String   @id
  seasonId        String
  supplierId      String?
  earTag          String
  status          String
  purchaseAmount  Decimal? @db.Decimal(18, 4)
  liveWeightKg    Decimal? @db.Decimal(12, 3)
  carcassWeightKg Decimal? @db.Decimal(12, 3)
  qurbanEligibility String @default("undecided")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  season          Season   @relation(fields: [seasonId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  shareCards      ShareCard[]
  slaughterJobs   SlaughterJob[]
  weighingRecords WeighingRecord[]
  weights         AnimalWeight[]
  healthEvents    AnimalHealthEvent[]
  qurbanAssignments QurbanAssignment[]
  purchaseInvoiceLine PurchaseInvoiceLine?

  @@unique([seasonId, earTag])
  @@index([supplierId])
}

model AnimalWeight {
  id               String   @id
  animalId         String
  kind             String
  weightKg         Decimal  @db.Decimal(12, 3)
  measuredAt       DateTime
  recordedByUserId String
  note             String?
  createdAt        DateTime @default(now())
  animal           Animal   @relation(fields: [animalId], references: [id])

  @@index([animalId, measuredAt])
}

model AnimalHealthEvent {
  id               String   @id
  animalId         String
  eventType        String
  status           String
  notes            String?
  occurredAt       DateTime
  recordedByUserId String
  createdAt        DateTime @default(now())
  animal           Animal   @relation(fields: [animalId], references: [id])

  @@index([animalId, occurredAt])
}

model QurbanAssignment {
  id               String   @id
  seasonId         String
  animalId         String
  qurbanNo         String?
  queueNo          Int?
  active           Boolean  @default(true)
  reason           String?
  assignedByUserId String
  assignedAt       DateTime
  endedAt          DateTime?
  previousId       String?
  createdAt        DateTime @default(now())
  season           Season   @relation(fields: [seasonId], references: [id])
  animal           Animal   @relation(fields: [animalId], references: [id])
  previous         QurbanAssignment? @relation("QurbanAssignmentHistory", fields: [previousId], references: [id])
  nextAssignments  QurbanAssignment[] @relation("QurbanAssignmentHistory")

  @@index([seasonId, queueNo])
  @@index([animalId, active])
}

model TenantIdempotencyRecord {
  key          String   @id
  scope        String
  actorUserId  String
  requestId    String
  requestHash  String
  resultType   String?
  resultId     String?
  resultPayload Json?
  status       String   @default("processing")
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([scope, actorUserId])
}

model ShareCard {
  id               String   @id
  seasonId         String
  animalId         String
  displayNo        String?
  targetShareCount Int      @default(7)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  season           Season   @relation(fields: [seasonId], references: [id])
  animal           Animal   @relation(fields: [animalId], references: [id])
  shares           Share[]
  slaughterJobs    SlaughterJob[]

  @@index([seasonId])
  @@index([animalId])
}

model Share {
  id            String   @id
  shareCardId   String
  sequenceNo    Int
  status        String
  customerId    String?
  agreedPrice   Decimal? @db.Decimal(18, 4)
  reservedUntil DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shareCard     ShareCard @relation(fields: [shareCardId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  saleShares    SaleShare[]
  proxyDocumentShares ProxyDocumentShare[]
  packages      PackageRecord[]
  deliveries    DeliveryRecord[]

  @@unique([shareCardId, sequenceNo])
  @@index([customerId])
}

model Sale {
  id             String   @id
  seasonId       String
  customerId     String
  status         String
  priceSnapshot  Decimal  @db.Decimal(18, 4)
  discountAmount Decimal? @db.Decimal(18, 4)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  season         Season   @relation(fields: [seasonId], references: [id])
  customer       Customer @relation(fields: [customerId], references: [id])
  shares         SaleShare[]
  ledgerEntries  LedgerEntry[]

  @@index([seasonId])
  @@index([customerId])
}

model SaleShare {
  saleId  String
  shareId String
  sale    Sale  @relation(fields: [saleId], references: [id])
  share   Share @relation(fields: [shareId], references: [id])

  @@id([saleId, shareId])
}

model LedgerEntry {
  id                String   @id
  seasonId          String
  type              String
  amount            Decimal  @db.Decimal(18, 4)
  currency          String
  saleId            String?
  customerId        String?
  reversalOfEntryId String?
  occurredAt        DateTime
  createdAt         DateTime @default(now())
  season            Season   @relation(fields: [seasonId], references: [id])
  sale              Sale?    @relation(fields: [saleId], references: [id])
  customer          Customer? @relation(fields: [customerId], references: [id])
  reversalOf        LedgerEntry? @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id])
  reversals         LedgerEntry[] @relation("LedgerReversal")

  @@index([seasonId])
  @@index([saleId])
  @@index([customerId])
  @@index([reversalOfEntryId])
}

model TenantAuditLog {
  id          String   @id
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  requestId   String
  occurredAt  DateTime
  metadata    Json?

  @@index([requestId])
  @@index([actorUserId])
}

model TenantOutboxMessage {
  id             String   @id
  topic          String
  payload        Json
  status         String
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([idempotencyKey])
}

model ProxyDocument {
  id          String   @id
  customerId  String
  status      String
  version     Int
  storageKey  String
  signedAt    DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  shares      ProxyDocumentShare[]

  @@index([customerId])
}

model ProxyDocumentShare {
  proxyDocumentId String
  shareId         String
  proxyDocument   ProxyDocument @relation(fields: [proxyDocumentId], references: [id])
  share           Share @relation(fields: [shareId], references: [id])

  @@id([proxyDocumentId, shareId])
}

model QrToken {
  id          String   @id
  purpose     String
  targetId    String
  opaqueToken String   @unique
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([purpose])
  @@index([targetId])
}

model SlaughterJob {
  id             String   @id
  seasonId       String
  animalId       String
  shareCardId    String
  status         String
  queueNo        Int?
  assignedUserId String?
  updatedAt      DateTime @updatedAt
  season         Season @relation(fields: [seasonId], references: [id])
  animal         Animal @relation(fields: [animalId], references: [id])
  shareCard      ShareCard @relation(fields: [shareCardId], references: [id])

  @@index([seasonId])
  @@index([animalId])
  @@index([shareCardId])
  @@index([queueNo])
}

model WeighingRecord {
  id               String   @id
  animalId         String
  carcassWeightKg  Decimal  @db.Decimal(12, 3)
  recordedByUserId String
  recordedAt       DateTime
  animal           Animal @relation(fields: [animalId], references: [id])

  @@index([animalId])
}

model PackageRecord {
  id            String   @id
  shareId       String
  grossWeightKg Decimal  @db.Decimal(12, 3)
  labelNo       String
  createdAt     DateTime @default(now())
  share         Share @relation(fields: [shareId], references: [id])

  @@index([shareId])
  @@unique([labelNo])
}

model DeliveryRecord {
  id             String   @id
  shareId        String
  customerId     String
  status         String
  deliveredAt    DateTime?
  reversedAt     DateTime?
  reversalReason String?
  share          Share @relation(fields: [shareId], references: [id])
  customer       Customer @relation(fields: [customerId], references: [id])

  @@index([shareId])
  @@index([customerId])
}

model OfflineQueueItem {
  id             String   @id
  idempotencyKey String   @unique
  operation      String
  payload        Json
  status         String
  createdAt      DateTime @default(now())

  @@index([status])
}

model DeviceAdapter {
  id           String   @id
  kind         String
  displayName  String
  capabilities Json
  enabled      Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
}
