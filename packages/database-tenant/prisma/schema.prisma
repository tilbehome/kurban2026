generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model TenantProvisioningMarker {
  id                String   @id
  provisioningJobId String
  tenantInstanceId  String
  databaseRefId     String
  createdAt         DateTime @default(now())
}

model Season {
  id                String                  @id
  locationId        String?
  name              String
  year              Int?
  status            String
  startsAt          DateTime?
  endsAt            DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  location          Location?               @relation(fields: [locationId], references: [id])
  legacyCustomers   Customer[]              @relation("LegacyCustomerSeason")
  customerAccounts  CustomerSeasonAccount[]
  animals           Animal[]
  shareCards        ShareCard[]
  sales             Sale[]
  priceTariffs      PriceTariff[]
  journalEntries    JournalEntry[]
  receipts          Receipt[]
  shareReservations ShareReservation[]
  shareTransfers    ShareTransfer[]
  ledgerEntries     LedgerEntry[]
  slaughterJobs     SlaughterJob[]
  supplierAccounts  SupplierAccount[]
  purchaseInvoices  PurchaseInvoice[]
  supplierPayments  SupplierPayment[]
  expenseDocuments  ExpenseDocument[]
  qurbanAssignments QurbanAssignment[]
  paddocks          Paddock[]
  paddockAssignments AnimalPaddockAssignment[]
  proxyDocuments    ProxyDocument[]

  @@index([locationId])
  @@index([status])
}

model OrganizationUser {
  id             String                   @id
  email          String?                  @unique
  displayName    String
  status         String                   @default("active")
  legacyUserId   String?                  @unique
  externalRef    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganizationMembership[]
  trustedDevices TrustedDevice[]
}

model OrganizationMembership {
  id                     String             @id
  organizationUserId     String
  status                 String             @default("active")
  validFrom              DateTime           @default(now())
  validUntil             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organizationUser       OrganizationUser   @relation(fields: [organizationUserId], references: [id])
  roleAssignments        MembershipRole[]   @relation("MembershipRoleTarget")
  assignedRoles          MembershipRole[]   @relation("MembershipRoleAssigner")
  createdRoleVersions    RoleVersion[]      @relation("RoleVersionCreator")
  delegationsFrom        Delegation[]       @relation("DelegationSource")
  delegationsTo          Delegation[]       @relation("DelegationTarget")
  approvedDelegations    Delegation[]       @relation("DelegationApprover")
  userSessions           UserSession[]
  createdServiceAccounts ServiceAccount[]
  requestedApprovals     ApprovalRequest[]  @relation("ApprovalRequester")
  approvalDecisions      ApprovalDecision[] @relation("ApprovalDecider")

  @@index([organizationUserId, status])
  @@index([validUntil])
}

model ModuleAuthorizationRegistration {
  id           String       @id
  moduleId     String
  version      String
  displayName  String
  active       Boolean      @default(true)
  registeredAt DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  permissions  Permission[]
  roles        Role[]

  @@unique([moduleId, version])
  @@index([moduleId, active])
}

model Role {
  id                   String                           @id
  name                 String
  description          String?
  type                 String
  protectedCode        String?                          @unique
  functionalArea       String
  accessLevel          String
  moduleRegistrationId String?
  sourceRoleId         String?
  active               Boolean                          @default(true)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  moduleRegistration   ModuleAuthorizationRegistration? @relation(fields: [moduleRegistrationId], references: [id])
  sourceRole           Role?                            @relation("RoleTemplateCopy", fields: [sourceRoleId], references: [id])
  copiedRoles          Role[]                           @relation("RoleTemplateCopy")
  versions             RoleVersion[]

  @@index([type, active])
  @@index([functionalArea, accessLevel])
  @@index([moduleRegistrationId])
}

model RoleVersion {
  id                    String                 @id
  roleId                String
  version               Int
  status                String                 @default("draft")
  changeReason          String
  createdByMembershipId String
  createdAt             DateTime               @default(now())
  publishedAt           DateTime?
  retiredAt             DateTime?
  role                  Role                   @relation(fields: [roleId], references: [id])
  createdBy             OrganizationMembership @relation("RoleVersionCreator", fields: [createdByMembershipId], references: [id])
  permissions           RolePermission[]
  membershipRoles       MembershipRole[]
  conditionalPolicies   ConditionalPolicy[]

  @@unique([roleId, version])
  @@index([roleId, status])
}

model Permission {
  id                   String                           @id
  key                  String                           @unique
  moduleId             String
  resource             String
  action               String
  scope                String
  description          String?
  riskLevel            String                           @default("normal")
  moduleRegistrationId String?
  active               Boolean                          @default(true)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  moduleRegistration   ModuleAuthorizationRegistration? @relation(fields: [moduleRegistrationId], references: [id])
  rolePermissions      RolePermission[]
  conditionalPolicies  ConditionalPolicy[]
  delegations          Delegation[]
  approvalPolicies     ApprovalPolicy[]                 @relation("ApprovalTargetPermission")
  approverPolicies     ApprovalPolicy[]                 @relation("ApprovalApproverPermission")
  serviceAccountGrants ServiceAccountPermission[]
  deviceGrants         DevicePermission[]
  externalUserGrants   ExternalUserPermission[]

  @@unique([moduleId, resource, action, scope])
  @@index([moduleId, active])
}

model RolePermission {
  roleVersionId String
  permissionId  String
  effect        String
  constraints   Json?
  createdAt     DateTime    @default(now())
  roleVersion   RoleVersion @relation(fields: [roleVersionId], references: [id])
  permission    Permission  @relation(fields: [permissionId], references: [id])

  @@id([roleVersionId, permissionId])
  @@index([permissionId, effect])
}

model AccessScope {
  id                    String                     @id
  name                  String
  facilityId            String?
  departmentId          String?
  operationalPeriodId   String?
  assignedRecordType    String?
  assignedRecordId      String?
  additionalConstraints Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  membershipRoles       MembershipRole[]
  delegations           Delegation[]
  serviceAccountGrants  ServiceAccountPermission[]
  deviceGrants          DevicePermission[]
  externalUserGrants    ExternalUserPermission[]
}

model MembershipRole {
  id                     String                 @id
  membershipId           String
  roleVersionId          String
  accessScopeId          String?
  validFrom              DateTime               @default(now())
  validUntil             DateTime?
  assignedByMembershipId String
  assignmentReason       String
  revokedAt              DateTime?
  revokedByMembershipId  String?
  createdAt              DateTime               @default(now())
  membership             OrganizationMembership @relation("MembershipRoleTarget", fields: [membershipId], references: [id])
  roleVersion            RoleVersion            @relation(fields: [roleVersionId], references: [id])
  accessScope            AccessScope?           @relation(fields: [accessScopeId], references: [id])
  assignedBy             OrganizationMembership @relation("MembershipRoleAssigner", fields: [assignedByMembershipId], references: [id])
  conditionalPolicies    ConditionalPolicy[]

  @@index([membershipId, revokedAt, validUntil])
  @@index([roleVersionId])
}

model ConditionalPolicy {
  id               String          @id
  name             String
  roleVersionId    String?
  membershipRoleId String?
  permissionId     String?
  effect           String
  priority         Int             @default(0)
  conditions       Json
  active           Boolean         @default(true)
  validFrom        DateTime?
  validUntil       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  roleVersion      RoleVersion?    @relation(fields: [roleVersionId], references: [id])
  membershipRole   MembershipRole? @relation(fields: [membershipRoleId], references: [id])
  permission       Permission?     @relation(fields: [permissionId], references: [id])

  @@index([permissionId, active])
  @@index([roleVersionId, active])
}

model Delegation {
  id                     String                  @id
  fromMembershipId       String
  toMembershipId         String
  permissionId           String
  accessScopeId          String?
  reason                 String
  validFrom              DateTime
  validUntil             DateTime
  status                 String                  @default("active")
  approvedByMembershipId String?
  revokedAt              DateTime?
  createdAt              DateTime                @default(now())
  fromMembership         OrganizationMembership  @relation("DelegationSource", fields: [fromMembershipId], references: [id])
  toMembership           OrganizationMembership  @relation("DelegationTarget", fields: [toMembershipId], references: [id])
  approvedBy             OrganizationMembership? @relation("DelegationApprover", fields: [approvedByMembershipId], references: [id])
  permission             Permission              @relation(fields: [permissionId], references: [id])
  accessScope            AccessScope?            @relation(fields: [accessScopeId], references: [id])

  @@index([toMembershipId, status, validUntil])
  @@index([fromMembershipId, status])
}

model ApprovalPolicy {
  id                      String            @id
  name                    String
  permissionId            String
  approverPermissionId    String
  conditions              Json
  requiredApprovals       Int               @default(1)
  requireDistinctUser     Boolean           @default(true)
  requireReauthentication Boolean           @default(true)
  active                  Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  permission              Permission        @relation("ApprovalTargetPermission", fields: [permissionId], references: [id])
  approverPermission      Permission        @relation("ApprovalApproverPermission", fields: [approverPermissionId], references: [id])
  requests                ApprovalRequest[]

  @@index([permissionId, active])
}

model ApprovalRequest {
  id                      String                 @id
  approvalPolicyId        String
  requestedByMembershipId String
  operationType           String
  operationRef            String
  payloadHash             String
  reason                  String
  status                  String                 @default("pending")
  expiresAt               DateTime
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  approvalPolicy          ApprovalPolicy         @relation(fields: [approvalPolicyId], references: [id])
  requestedBy             OrganizationMembership @relation("ApprovalRequester", fields: [requestedByMembershipId], references: [id])
  decisions               ApprovalDecision[]

  @@unique([operationType, operationRef, payloadHash])
  @@index([status, expiresAt])
}

model ApprovalDecision {
  id                    String                 @id
  approvalRequestId     String
  decidedByMembershipId String
  decision              String
  reason                String
  reauthenticatedAt     DateTime
  decidedAt             DateTime
  approvalRequest       ApprovalRequest        @relation(fields: [approvalRequestId], references: [id])
  decidedBy             OrganizationMembership @relation("ApprovalDecider", fields: [decidedByMembershipId], references: [id])

  @@unique([approvalRequestId, decidedByMembershipId])
}

model UserSession {
  id                       String                 @id
  organizationMembershipId String
  tokenHash                String                 @unique
  status                   String                 @default("active")
  mfaLevel                 Int                    @default(1)
  authenticatedAt          DateTime
  lastReauthenticatedAt    DateTime?
  trustedDeviceId          String?
  networkFingerprint       String?
  expiresAt                DateTime
  revokedAt                DateTime?
  createdAt                DateTime               @default(now())
  membership               OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])
  trustedDevice            TrustedDevice?         @relation(fields: [trustedDeviceId], references: [id])

  @@index([organizationMembershipId, status])
  @@index([expiresAt])
}

model TrustedDevice {
  id                 String           @id
  organizationUserId String
  displayName        String
  fingerprintHash    String
  trustStatus        String           @default("trusted")
  trustedAt          DateTime
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organizationUser   OrganizationUser @relation(fields: [organizationUserId], references: [id])
  sessions           UserSession[]

  @@unique([organizationUserId, fingerprintHash])
  @@index([trustStatus, expiresAt])
}

model ServiceAccount {
  id                    String                     @id
  name                  String
  clientId              String                     @unique
  credentialHash        String
  status                String                     @default("active")
  createdByMembershipId String
  validUntil            DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  createdBy             OrganizationMembership     @relation(fields: [createdByMembershipId], references: [id])
  permissions           ServiceAccountPermission[]
}

model ServiceAccountPermission {
  serviceAccountId String
  permissionId     String
  accessScopeId    String?
  effect           String
  validFrom        DateTime       @default(now())
  validUntil       DateTime?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id])
  permission       Permission     @relation(fields: [permissionId], references: [id])
  accessScope      AccessScope?   @relation(fields: [accessScopeId], references: [id])

  @@id([serviceAccountId, permissionId])
}

model DeviceIdentity {
  id             String             @id
  kind           String
  displayName    String
  credentialHash String             @unique
  status         String             @default("active")
  facilityId     String?
  validUntil     DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  permissions    DevicePermission[]
}

model DevicePermission {
  deviceIdentityId String
  permissionId     String
  accessScopeId    String?
  effect           String
  validFrom        DateTime       @default(now())
  validUntil       DateTime?
  deviceIdentity   DeviceIdentity @relation(fields: [deviceIdentityId], references: [id])
  permission       Permission     @relation(fields: [permissionId], references: [id])
  accessScope      AccessScope?   @relation(fields: [accessScopeId], references: [id])

  @@id([deviceIdentityId, permissionId])
}

model ExternalUser {
  id          String                   @id
  issuer      String
  subject     String
  email       String?
  displayName String?
  status      String                   @default("active")
  validUntil  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  permissions ExternalUserPermission[]

  @@unique([issuer, subject])
}

model ExternalUserPermission {
  externalUserId String
  permissionId   String
  accessScopeId  String?
  effect         String
  validFrom      DateTime     @default(now())
  validUntil     DateTime?
  externalUser   ExternalUser @relation(fields: [externalUserId], references: [id])
  permission     Permission   @relation(fields: [permissionId], references: [id])
  accessScope    AccessScope? @relation(fields: [accessScopeId], references: [id])

  @@id([externalUserId, permissionId])
}

model AuthorizationAudit {
  id                       String   @id
  identityKind             String
  subjectId                String?
  organizationMembershipId String?
  sessionId                String?
  permissionKey            String
  resourceType             String?
  resourceId               String?
  decision                 String
  reasonCodes              Json
  evaluatedPolicies        Json?
  contextSnapshot          Json?
  requestId                String
  traceId                  String?
  occurredAt               DateTime

  @@index([organizationMembershipId, occurredAt])
  @@index([permissionKey, decision, occurredAt])
  @@index([requestId])
}

model BusinessProfile {
  id              String   @id
  legalName       String
  displayName     String
  taxOffice       String?
  taxNumber       String?
  phone           String?
  email           String?
  defaultCurrency String   @default("TRY")
  locale          String   @default("tr-TR")
  timeZone        String   @default("Europe/Istanbul")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Location {
  id          String            @id
  code        String            @unique
  name        String
  addressLine String?
  district    String?
  city        String?
  phone       String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  seasons     Season[]
  animals     Animal[]
  invoices    PurchaseInvoice[]
}

model Setting {
  id          String   @id
  scope       String
  key         String
  value       Json
  version     Int      @default(1)
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
}

model UnitOfMeasure {
  id               String                @id
  tenantId         String
  code             String
  name             String
  symbol           String
  category         String
  decimalPrecision Int                   @default(0)
  allowsFraction   Boolean               @default(false)
  isSystem         Boolean               @default(false)
  isActive         Boolean               @default(true)
  sortOrder        Int                   @default(0)
  createdByUserId  String
  updatedByUserId  String
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  invoiceLines     PurchaseInvoiceLine[]
  providerMappings UnitProviderMapping[]

  @@unique([tenantId, code])
  @@index([tenantId, category, isActive, sortOrder])
}

model UnitProviderMapping {
  id               String        @id
  tenantId         String
  providerKey      String
  mappingVersion   String
  unitOfMeasureId  String
  providerUnitCode String
  isActive         Boolean       @default(true)
  createdByUserId  String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  unitOfMeasure    UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  @@unique([tenantId, providerKey, mappingVersion, unitOfMeasureId])
  @@index([tenantId, providerKey, mappingVersion, isActive])
}

model Customer {
  id                     String                  @id
  seasonId               String?
  displayName            String
  normalizedName         String                  @default("")
  phone                  String?
  normalizedPhone        String?
  identityNumber         String?
  notes                  String?
  active                 Boolean                 @default(true)
  kvkkConsentAt          DateTime?
  communicationConsentAt DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  legacySeason           Season?                 @relation("LegacyCustomerSeason", fields: [seasonId], references: [id])
  phones                 CustomerPhone[]
  addresses              CustomerAddress[]
  seasonAccounts         CustomerSeasonAccount[]
  sales                  Sale[]
  receipts               Receipt[]
  payerSales             Sale[]                  @relation("SalePayerCustomer")
  reservedShares         Share[]                 @relation("ShareReservationCustomer")
  shareReservations      ShareReservation[]
  payerReceipts          Receipt[]               @relation("ReceiptPayerCustomer")
  transferSources        ShareTransfer[]         @relation("ShareTransferFromCustomer")
  transferTargets        ShareTransfer[]         @relation("ShareTransferToCustomer")
  journalLines           JournalLine[]
  shares                 Share[]
  paymentAllocations     PaymentAllocation[]
  ledgerEntries          LedgerEntry[]
  proxyDocuments         ProxyDocument[]
  deliveries             DeliveryRecord[]
  invoices               PurchaseInvoice[]

  @@index([seasonId])
  @@index([normalizedPhone])
  @@index([normalizedName])
  @@index([active])
}

model CustomerPhone {
  id              String   @id
  customerId      String
  label           String?
  phone           String
  normalizedPhone String
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([normalizedPhone])
}

model CustomerAddress {
  id          String   @id
  customerId  String
  label       String?
  addressLine String
  district    String?
  city        String?
  postalCode  String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerSeasonAccount {
  id          String   @id
  customerId  String
  seasonId    String
  status      String   @default("open")
  debitTotal  Decimal  @default(0) @db.Decimal(18, 4)
  creditTotal Decimal  @default(0) @db.Decimal(18, 4)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  season      Season   @relation(fields: [seasonId], references: [id])

  @@unique([customerId, seasonId])
  @@index([seasonId])
}

model Supplier {
  id               String            @id
  displayName      String
  phone            String?
  taxNumber        String?
  normalizedName   String            @default("")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  animals          Animal[]
  accounts         SupplierAccount[]
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]

  @@index([normalizedName])
}

model SupplierAccount {
  id          String   @id
  supplierId  String
  seasonId    String
  debitTotal  Decimal  @default(0) @db.Decimal(18, 4)
  creditTotal Decimal  @default(0) @db.Decimal(18, 4)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  season      Season   @relation(fields: [seasonId], references: [id])

  @@unique([supplierId, seasonId])
  @@index([seasonId])
}

model PurchaseInvoice {
  id                 String                       @id
  organizationId     String
  supplierId         String?
  customerId         String?
  seasonId           String
  locationId         String?
  uuid               String                       @unique
  invoiceNo          String
  series             String?
  invoiceDate        DateTime
  dueDate            DateTime?
  direction          String                       @default("INBOUND")
  tradeType          String                       @default("PURCHASE")
  documentNature     String                       @default("STANDARD")
  electronicChannel  String                       @default("NONE")
  accountingStatus   String                       @default("DRAFT")
  paymentStatus      String                       @default("UNPAID")
  electronicStatus   String                       @default("NOT_APPLICABLE")
  currency           String                       @default("TRY")
  partyTaxIdentity   String?
  partySnapshot      Json
  subtotal           Decimal                      @db.Decimal(18, 4)
  discountTotal      Decimal                      @default(0) @db.Decimal(18, 4)
  taxTotal           Decimal                      @default(0) @db.Decimal(18, 4)
  grandTotal         Decimal                      @db.Decimal(18, 4)
  paidTotal          Decimal                      @default(0) @db.Decimal(18, 4)
  idempotencyKey     String                       @unique
  requestId          String
  providerKey        String?
  providerReference  String?
  originalInvoiceId  String?
  reversalOfId       String?
  journalEntryId     String?                      @unique
  createdByUserId    String
  approvedByUserId   String?
  postedByUserId     String?
  approvedAt         DateTime?
  postedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  supplier           Supplier?                    @relation(fields: [supplierId], references: [id])
  customer           Customer?                    @relation(fields: [customerId], references: [id])
  season             Season                       @relation(fields: [seasonId], references: [id])
  location           Location?                    @relation(fields: [locationId], references: [id])
  journalEntry       JournalEntry?                @relation(fields: [journalEntryId], references: [id])
  lines              PurchaseInvoiceLine[]
  taxComponents      InvoiceTaxComponent[]
  attachments        InvoiceAttachment[]
  timeline           InvoiceTimelineEvent[]
  paymentAllocations InvoicePaymentAllocation[]
  deliveries         ElectronicDocumentDelivery[]
  originalInvoice    PurchaseInvoice?             @relation("InvoiceOriginal", fields: [originalInvoiceId], references: [id])
  relatedDocuments   PurchaseInvoice[]            @relation("InvoiceOriginal")
  reversalOf         PurchaseInvoice?             @relation("PurchaseInvoiceReversal", fields: [reversalOfId], references: [id])
  reversals          PurchaseInvoice[]            @relation("PurchaseInvoiceReversal")

  @@unique([organizationId, invoiceNo])
  @@index([seasonId, invoiceDate])
  @@index([locationId])
  @@index([supplierId])
  @@index([customerId])
  @@index([accountingStatus, paymentStatus, electronicStatus])
  @@index([providerKey, providerReference])
  @@index([originalInvoiceId, accountingStatus])
}

model PurchaseInvoiceLine {
  id                 String                @id
  purchaseInvoiceId  String
  lineNo             Int
  description        String
  animalId           String?               @unique
  quantity           Decimal               @default(1) @db.Decimal(12, 3)
  unitPrice          Decimal               @db.Decimal(18, 4)
  lineTotal          Decimal               @db.Decimal(18, 4)
  unitId             String
  unitCodeSnapshot   String
  unitNameSnapshot   String
  unitSymbolSnapshot String
  discountTotal      Decimal               @default(0) @db.Decimal(18, 4)
  taxTotal           Decimal               @default(0) @db.Decimal(18, 4)
  saleId             String?
  shareId            String?
  purchaseReference  String?
  expenseDocumentId  String?
  createdAt          DateTime              @default(now())
  purchaseInvoice    PurchaseInvoice       @relation(fields: [purchaseInvoiceId], references: [id])
  animal             Animal?               @relation(fields: [animalId], references: [id])
  expenseDocument    ExpenseDocument?      @relation(fields: [expenseDocumentId], references: [id])
  unitOfMeasure      UnitOfMeasure         @relation(fields: [unitId], references: [id])
  taxComponents      InvoiceTaxComponent[]

  @@unique([purchaseInvoiceId, lineNo])
  @@index([unitId])
}

model InvoiceTaxComponent {
  id                String               @id
  purchaseInvoiceId String
  lineId            String?
  taxType           String
  rate              Decimal              @db.Decimal(9, 4)
  taxableAmount     Decimal              @db.Decimal(18, 4)
  taxAmount         Decimal              @db.Decimal(18, 4)
  exemptionCode     String?
  createdAt         DateTime             @default(now())
  purchaseInvoice   PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id])
  line              PurchaseInvoiceLine? @relation(fields: [lineId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([lineId, purchaseInvoiceId])
}

model InvoiceAttachment {
  id                String          @id
  purchaseInvoiceId String
  kind              String
  storageKey        String
  mediaType         String
  checksum          String
  createdAt         DateTime        @default(now())
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])

  @@unique([purchaseInvoiceId, kind, checksum])
}

model InvoiceTimelineEvent {
  id                String          @id
  purchaseInvoiceId String
  type              String
