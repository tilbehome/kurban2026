generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

model Organization {
  id               String                       @id
  slug             String                       @unique
  displayName      String
  status           String
  version          Int                          @default(0)
  ownerContactRef  String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  tenants          TenantInstance[]
  licenses         PlatformLicense[]
  auditLogs        PlatformAuditLog[]
  emergencyStops   EmergencyStop[]
  supportSessions  PlatformSupportSession[]
  lifecycleEvents  OrganizationLifecycleEvent[]
  adminInvitations TenantAdminInvitation[]
  operationJobs    OrganizationOperationJob[]
}

model TenantInstance {
  id                 String                     @id
  organizationId     String
  slug               String                     @unique
  displayName        String
  provisioningStatus String
  runtimeStatus      String                     @default("unknown")
  releaseChannel     String
  databaseRefId      String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  organization       Organization               @relation(fields: [organizationId], references: [id])
  databaseRef        TenantDatabaseRef          @relation(fields: [databaseRefId], references: [id])
  healthSnapshots    TenantHealthSnapshot[]
  emergencyStops     EmergencyStop[]
  customDomains      TenantCustomDomain[]
  supportSessions    PlatformSupportSession[]
  auditLogs          PlatformAuditLog[]
  backupRecords      PlatformTenantBackup[]
  adminInvitations   TenantAdminInvitation[]
  operationJobs      OrganizationOperationJob[]

  @@index([organizationId])
}

model TenantDatabaseRef {
  id              String           @id
  engine          String
  managed         Boolean
  region          String?
  status          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenantInstances TenantInstance[]
}

model PlatformPlan {
  id               String                  @id
  code             String                  @unique
  displayName      String
  status           String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  modules          PlatformPlanModule[]
  licenses         PlatformLicense[]
  scheduledChanges PlatformLicenseChange[]
  maxUsers         Int?
  maxDevices       Int?
  maxStorageMb     Int?
  maxAnimals       Int?
  maxSeasons       Int?
}

model PlatformModule {
  id             String                       @id
  key            String                       @unique
  displayName    String
  status         String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  plans          PlatformPlanModule[]
  entitlements   PlatformLicenseEntitlement[]
  emergencyStops EmergencyStop[]
}

model PlatformPlanModule {
  planId     String
  moduleId   String
  enabled    Boolean
  validUntil DateTime?
  plan       PlatformPlan   @relation(fields: [planId], references: [id])
  module     PlatformModule @relation(fields: [moduleId], references: [id])

  @@id([planId, moduleId])
}

model PlatformLicense {
  id             String                       @id
  organizationId String
  planId         String
  status         String
  startsAt       DateTime
  expiresAt      DateTime?
  maxUsers       Int?
  maxDevices     Int?
  maxStorageMb   Int?
  maxAnimals     Int?
  maxSeasons     Int?
  version        Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  plan           PlatformPlan                 @relation(fields: [planId], references: [id])
  entitlements   PlatformLicenseEntitlement[]
  changes        PlatformLicenseChange[]

  @@index([organizationId])
  @@index([planId])
}

model PlatformLicenseEntitlement {
  licenseId  String
  moduleId   String
  enabled    Boolean
  validUntil DateTime?
  license    PlatformLicense @relation(fields: [licenseId], references: [id])
  module     PlatformModule  @relation(fields: [moduleId], references: [id])

  @@id([licenseId, moduleId])
}

model PlatformUser {
  id                             String                          @id
  email                          String                          @unique
  displayName                    String
  status                         String
  passwordHash                   String?
  failedLoginCount               Int                             @default(0)
  lockedUntil                    DateTime?
  lastLoginAt                    DateTime?
  mfaRequired                    Boolean                         @default(true)
  authVersion                    Int                             @default(0)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  roles                          PlatformUserRole[]
  auditLogs                      PlatformAuditLog[]
  mfaEnrollments                 PlatformMfaEnrollment[]
  sessions                       PlatformSession[]
  devices                        PlatformDevice[]
  provisioningJobs               PlatformProvisioningJob[]
  emergencyStops                 EmergencyStop[]
  supportTicketLinks             PlatformSupportTicketLink[]
  requestedSupportSessions       PlatformSupportSession[]        @relation("SupportRequester")
  revokedSupportSessions         PlatformSupportSession[]        @relation("SupportRevoker")
  commandJobs                    PlatformAdminCommand[]
  lifecycleEvents                OrganizationLifecycleEvent[]
  licenseChanges                 PlatformLicenseChange[]
  adminInvitations               TenantAdminInvitation[]
  webAuthnCredentials            PlatformWebAuthnCredential[]
  authChallenges                 PlatformAuthChallenge[]
  recoveryCodes                  PlatformRecoveryCode[]
  incidentsCreated               PlatformIncident[]
  maintenanceWindowsCreated      MaintenanceWindow[]
  incidentTimelineEntries        PlatformIncidentTimelineEntry[]
  organizationOperationJobs      OrganizationOperationJob[]      @relation("OperationRequester")
  organizationOperationApprovals OrganizationOperationJob[]      @relation("OperationApprover")
}

model PlatformRole {
  id          String             @id
  key         String             @unique
  displayName String
  status      String             @default("active")
  permissions Json               @default("[]")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       PlatformUserRole[]
}

model PlatformUserRole {
  userId String
  roleId String
  user   PlatformUser @relation(fields: [userId], references: [id])
  role   PlatformRole @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model PlatformAuditLog {
  id               String          @id
  organizationId   String?
  tenantInstanceId String?
  actorUserId      String?
  action           String
  targetType       String
  targetId         String?
  requestId        String?
  supportSessionId String?
  result           String
  metadata         Json?
  occurredAt       DateTime        @default(now())
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  tenantInstance   TenantInstance? @relation(fields: [tenantInstanceId], references: [id])
  actorUser        PlatformUser?   @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([tenantInstanceId])
  @@index([actorUserId])
  @@index([requestId])
}

model TenantCustomDomain {
  id               String         @id
  tenantInstanceId String
  hostname         String         @unique
  status           String
  dnsVerified      Boolean        @default(false)
  tlsReady         Boolean        @default(false)
  isPrimary        Boolean        @default(false)
  verifiedAt       DateTime?
  failureCode      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenantInstance   TenantInstance @relation(fields: [tenantInstanceId], references: [id])

  @@index([tenantInstanceId])
}

model PlatformSupportSession {
  id               String         @id
  organizationId   String
  tenantInstanceId String
  platformUserId   String
  /// Opaque tenant user identity; this must not resolve through PlatformUser.
  approvedByUserId String
  reason           String
  status           String
  scopes           Json
  startsAt         DateTime
  expiresAt        DateTime
  endedAt          DateTime?
  revokedByUserId  String?
  revocationReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id])
  tenantInstance   TenantInstance @relation(fields: [tenantInstanceId], references: [id])
  platformUser     PlatformUser   @relation("SupportRequester", fields: [platformUserId], references: [id])
  revokedByUser    PlatformUser?  @relation("SupportRevoker", fields: [revokedByUserId], references: [id])

  @@index([organizationId])
  @@index([tenantInstanceId])
  @@index([platformUserId])
  @@index([expiresAt])
  @@index([revokedByUserId])
}

model PlatformMfaEnrollment {
  id               String       @id
  userId           String
  method           String
  status           String
  createdAt        DateTime     @default(now())
  activatedAt      DateTime?
  revokedAt        DateTime?
  secretCiphertext String?
  secretKeyVersion String?
  user             PlatformUser @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PlatformWebAuthnCredential {
  id                 String       @id
  credentialId       String       @unique
  userId             String
  publicKeyBase64url String
  counter            BigInt       @default(0)
  transports         Json
  deviceType         String
  backedUp           Boolean      @default(false)
  label              String
  status             String       @default("active")
  createdAt          DateTime     @default(now())
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  user               PlatformUser @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model PlatformAuthChallenge {
  id         String       @id
  userId     String
  purpose    String
  challenge  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  user       PlatformUser @relation(fields: [userId], references: [id])

  @@index([userId, purpose, expiresAt])
}

model PlatformRecoveryCode {
  id        String       @id
  userId    String
  batchId   String
  codeHash  String       @unique
  createdAt DateTime     @default(now())
  usedAt    DateTime?
  revokedAt DateTime?
  user      PlatformUser @relation(fields: [userId], references: [id])

  @@index([userId, batchId])
}

model PlatformDevice {
  id          String            @id
  userId      String
  label       String
  userAgent   String?
  trustStatus String
  firstSeenAt DateTime
  lastSeenAt  DateTime
  user        PlatformUser      @relation(fields: [userId], references: [id])
  sessions    PlatformSession[]

  @@index([userId])
}

model PlatformSession {
  id                    String         @id
  userId                String
  deviceId              String
  status                String
  createdAt             DateTime       @default(now())
  lastSeenAt            DateTime
  expiresAt             DateTime
  revokedAt             DateTime?
  tokenHash             String?        @unique
  authVersion           Int            @default(0)
  rotatedAt             DateTime?
  ipHash                String?
  lastReauthenticatedAt DateTime?
  user                  PlatformUser   @relation(fields: [userId], references: [id])
  device                PlatformDevice @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

model PlatformProvisioningJob {
  id                            String       @id
  idempotencyKey                String       @unique
  commandFingerprint            String
  organizationId                String
  tenantInstanceId              String
  requestedByUserId             String
  databaseRefId                 String
  status                        String
  steps                         Json
  currentStep                   String?
  failureCode                   String?
  databaseCreatedByJob          Boolean      @default(false)
  platformRegistrationCompleted Boolean      @default(false)
  rollbackStatus                String?
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  requestedByUser               PlatformUser @relation(fields: [requestedByUserId], references: [id])

  @@unique([tenantInstanceId])
  @@index([organizationId])
  @@index([requestedByUserId])
}

model TenantHealthSnapshot {
  id                 String         @id
  tenantInstanceId   String
  status             String
  version            String?
  migrationVersion   String?
  lastBackupAt       DateTime?
  lastRestoreDrillAt DateTime?
  checkedAt          DateTime
  tenantInstance     TenantInstance @relation(fields: [tenantInstanceId], references: [id])

  @@index([tenantInstanceId])
}

model EmergencyStop {
  id               String          @id
  organizationId   String
  tenantInstanceId String?
  moduleId         String?
  status           String
  mode             String          @default("full_stop")
  blockedScopes    Json            @default("[]")
  version          Int             @default(0)
  reason           String?
  changedByUserId  String
  changedAt        DateTime
  organization     Organization    @relation(fields: [organizationId], references: [id])
  tenantInstance   TenantInstance? @relation(fields: [tenantInstanceId], references: [id])
  module           PlatformModule? @relation(fields: [moduleId], references: [id])
  changedByUser    PlatformUser    @relation(fields: [changedByUserId], references: [id])

  @@index([organizationId])
  @@index([tenantInstanceId])
  @@index([moduleId])
}

model PlatformIncident {
  id                String                          @id
  organizationId    String?
  severity          String
  status            String
  title             String
  message           String
  affectedTenantIds Json
  openedAt          DateTime
  resolvedAt        DateTime?
  updatedAt         DateTime                        @updatedAt
  createdByUserId   String?
  createdByUser     PlatformUser?                   @relation(fields: [createdByUserId], references: [id])
  timeline          PlatformIncidentTimelineEntry[]

  @@index([status, openedAt])
}

model PlatformIncidentTimelineEntry {
  id          String           @id
  incidentId  String
  actorUserId String
  action      String
  message     String
  requestId   String
  occurredAt  DateTime         @default(now())
  incident    PlatformIncident @relation(fields: [incidentId], references: [id])
  actorUser   PlatformUser     @relation(fields: [actorUserId], references: [id])

  @@index([incidentId, occurredAt])
}

model MaintenanceWindow {
  id                String        @id
  status            String
  title             String
  message           String
  affectedTenantIds Json
  plannedStartAt    DateTime
  plannedEndAt      DateTime
  startedAt         DateTime?
  endedAt           DateTime?
  cancelledAt       DateTime?
  mode              String        @default("read_only")
  createdByUserId   String?
  createdByUser     PlatformUser? @relation(fields: [createdByUserId], references: [id])

  @@index([status, plannedStartAt])
}

model PlatformSupportTicketLink {
  ticketId         String       @id
  supportSessionId String
  linkedByUserId   String
  linkedAt         DateTime
  linkedByUser     PlatformUser @relation(fields: [linkedByUserId], references: [id])

  @@index([supportSessionId])
  @@index([linkedByUserId])
}

model PlatformAdminCommand {
  id                String       @id
  idempotencyKey    String       @unique
  type              String
  status            String
  organizationId    String?
  tenantInstanceId  String?
  requestedByUserId String
  requestId         String
  traceId           String
  approvalReason    String
  payload           Json
  attempts          Int          @default(0)
  version           Int          @default(0)
  errorCode         String?
  resultRef         String?
  createdAt         DateTime     @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  updatedAt         DateTime     @updatedAt
  requestedByUser   PlatformUser @relation(fields: [requestedByUserId], references: [id])

  @@index([status, createdAt])
  @@index([organizationId])
  @@index([tenantInstanceId])
  @@index([requestedByUserId])
}

model OrganizationLifecycleEvent {
  id               String       @id
  organizationId   String
  fromStatus       String
  toStatus         String
  reason           String
  impactSummary    String
  approvedByUserId String
  requestId        String
  occurredAt       DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id])
  approvedByUser   PlatformUser @relation(fields: [approvedByUserId], references: [id])

  @@index([organizationId, occurredAt])
}

model TenantAdminInvitation {
  id               String         @id
  organizationId   String
  tenantInstanceId String
  email            String
  displayName      String
  roleKey          String
  status           String
  tokenHash        String?
  expiresAt        DateTime?
  invitedByUserId  String
  createdAt        DateTime       @default(now())
  acceptedAt       DateTime?
  revokedAt        DateTime?
  sentAt           DateTime?
  resendCount      Int            @default(0)
  organization     Organization   @relation(fields: [organizationId], references: [id])
  tenantInstance   TenantInstance @relation(fields: [tenantInstanceId], references: [id])
  invitedByUser    PlatformUser   @relation(fields: [invitedByUserId], references: [id])

  @@unique([tenantInstanceId, email])
  @@index([organizationId])
  @@index([invitedByUserId])
}

model OrganizationOperationJob {
  id                     String          @id
  idempotencyKey         String          @unique
  organizationId         String
  tenantInstanceId       String?
  type                   String
  status                 String
  reason                 String
  requestId              String
  requestedByUserId      String
  approvedByUserId       String?
  requiresSecondApproval Boolean         @default(false)
  reauthenticatedAt      DateTime
  payload                Json
  resultMetadata         Json?
  errorCode              String?
  version                Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  completedAt            DateTime?
  cancelledAt            DateTime?
  organization           Organization    @relation(fields: [organizationId], references: [id])
  tenantInstance         TenantInstance? @relation(fields: [tenantInstanceId], references: [id])
  requestedByUser        PlatformUser    @relation("OperationRequester", fields: [requestedByUserId], references: [id])
  approvedByUser         PlatformUser?   @relation("OperationApprover", fields: [approvedByUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model PlatformTenantBackup {
  id                 String         @id
  tenantInstanceId   String
  databaseRefId      String
  createdAt          DateTime
  migrationVersion   String
  checksumSha256     String?
  sizeBytes          BigInt?
  status             String
  verificationStatus String
  verifiedAt         DateTime?
  failureCode        String?
  updatedAt          DateTime       @updatedAt
  tenantInstance     TenantInstance @relation(fields: [tenantInstanceId], references: [id])

  @@index([tenantInstanceId, createdAt])
  @@index([status])
}

model PlatformLicenseChange {
  id                String          @id
  licenseId         String
  targetPlanId      String
  effectiveAt       DateTime
  reason            String
  status            String
  requestedByUserId String
  expectedVersion   Int
  createdAt         DateTime        @default(now())
  appliedAt         DateTime?
  license           PlatformLicense @relation(fields: [licenseId], references: [id])
  targetPlan        PlatformPlan    @relation(fields: [targetPlanId], references: [id])
  requestedByUser   PlatformUser    @relation(fields: [requestedByUserId], references: [id])

  @@index([licenseId, effectiveAt])
  @@index([status])
}
